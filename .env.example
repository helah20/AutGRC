# Copy to .env and adjust. Required in production: JWT_SECRET.
NODE_ENV=development
PORT=4000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d

# Number of reverse proxies in front of the application, or unset when there is
# none. Only set this when a proxy you control sets X-Forwarded-For: trusting
# the header without one lets a caller choose the address the rate limiters key
# on, and rotating it resets the bucket.
TRUST_PROXY=

# Upload ceiling for evidence files, in bytes. Default 15 MB.
MAX_UPLOAD_BYTES=

# AI provider. Leave ANTHROPIC_API_KEY empty to use the built-in deterministic
# generation engine, which works fully offline.
AI_PROVIDER=builtin
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Sampling temperature for the Claude provider. Default 0.2: governance text
# should not vary in terminology between runs, because that variation is exactly
# what the consistency engine reports as drift.
AI_TEMPERATURE=

# Initial password for the seeded demo accounts.
SEED_PASSWORD=Autgrc#2025
