# Copy to .env and adjust. Required in production: JWT_SECRET.
NODE_ENV=development
PORT=4000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d

# AI provider. Leave ANTHROPIC_API_KEY empty to use the built-in deterministic
# generation engine, which works fully offline.
AI_PROVIDER=builtin
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Initial password for the seeded demo accounts.
SEED_PASSWORD=Autgrc#2025
