# انسخ هذا الملف إلى .env ثم عدّل القيم.
# Copy to .env and adjust.

# مفتاح تشفير بيانات الاعتماد في n8n. ولّده مرة واحدة ولا تغيّره بعد ذلك:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# المنطقة الزمنية
GENERIC_TIMEZONE=Asia/Riyadh

# نموذج المحادثة ونموذج التضمين (Embeddings) في Ollama.
# qwen2.5 جيد في العربية. على جهاز بذاكرة أقل من 16GB جرّب qwen2.5:3b.
# bge-m3 نموذج تضمين متعدد اللغات يدعم العربية (1024 بُعدًا).
CHAT_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3

# اسم مجموعة Qdrant التي تُخزَّن فيها المقاطع.
QDRANT_COLLECTION=knowledge_base
